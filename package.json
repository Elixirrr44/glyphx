{
  "name": "glyphx",
  "productName": "GlyphX",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "unicode:names": "python scripts/generate-names.py",
    "icons": "node scripts/make-icon.mjs",
    "desktop:web": "node scripts/desktop.mjs web",
    "desktop": "node scripts/desktop.mjs start",
    "desktop:dist": "node scripts/desktop.mjs dist",
    "desktop:selftest": "node scripts/desktop.mjs selftest",
    "pages:build": "node scripts/pages.mjs build",
    "pages:preview": "node scripts/pages.mjs preview",
    "pages:publish": "node scripts/pages.mjs publish"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "GlyphX — advanced Unicode text & emoji designer",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "electron/main.cjs",
  "author": "GlyphX",
  "build": {
    "appId": "app.glyphx.desktop",
    "productName": "GlyphX",
    "copyright": "Copyright © 2026 GlyphX",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GlyphX",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/assets/icon.png",
      "category": "Graphics"
    }
  }
}
